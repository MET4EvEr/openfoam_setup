# ==============================================================================
# Git Ignore Configuration for OpenFOAM Course Environment
# ==============================================================================
#
# PURPOSE:
# Keeps the repository clean by ignoring local configuration secrets, compiled
# Python artifacts, OS metadata, and generated simulation output, while ensuring
# foundational course cases (like test_cavity) remain tracked.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment and Local Host Configurations
# ------------------------------------------------------------------------------
# Never commit the active .env file (it contains host-specific absolute paths)
.env
!.env.example

# ------------------------------------------------------------------------------
# 2. Python Virtual Environments and Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.pytest_cache/
.coverage
htmlcov/
.uv/
uv.lock

# ------------------------------------------------------------------------------
# 3. Operating System Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 4. Code Editors & IDEs
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 5. OpenFOAM Simulation Artifacts & Solver Output (All Cases)
# ------------------------------------------------------------------------------
# Solver log files (e.g. log, log.blockMesh, log.icoFoam, simpleFoam.log)
log
log.*
*.log

# Convergence residual plots
residuals.png
**/residuals.png
residuals_*.png
**/residuals_*.png

# Marker files for ParaView
*.foam

# Post-processing outputs and dynamic code compilation
postProcessing/
**/postProcessing/
dynamicCode/
**/dynamicCode/

# VTK visualization exports (foamToVTK)
VTK/
**/VTK/
**/VTK/**
vtk/
**/vtk/
**/vtk/**
*.vtm.series
*.vtm
*.vtu
*.vtp
*.vtk

# Parallel decomposition processor directories (e.g. processor0, processor1)
processor*/
**/processor*/

# Jupyter notebook checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 6. Generated Mesh Files in polyMesh
# ------------------------------------------------------------------------------
# Ignore polyMesh directory and all its contents across all cases
polyMesh/
**/polyMesh/
**/polyMesh/**

# ------------------------------------------------------------------------------
# 7. Time-Step Result Directories (All Cases)
# ------------------------------------------------------------------------------
# Ignore time step folders starting with positive digits (e.g., 1/, 2/, 100/)
openfoam_course_workspace/**/[1-9]*/
# Ignore decimal time step folders (e.g., 0.1/, 0.005/, 1.5/)
openfoam_course_workspace/**/0.*[0-9]*/
openfoam_course_workspace/**/[0-9]*.*[0-9]*/
# Ignore scientific notation time step folders (e.g., 1e-05/, 5e-06/)
openfoam_course_workspace/**/[0-9]*e[+-]*/

# Explicitly ensure the initial condition folder '0/' and '0.orig/' are ALWAYS tracked!
!openfoam_course_workspace/**/0/
!openfoam_course_workspace/**/0/**
!openfoam_course_workspace/**/0.orig/
!openfoam_course_workspace/**/0.orig/**
