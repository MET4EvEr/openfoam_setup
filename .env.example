# ==============================================================================
# OpenFOAM Course Environment Configuration Template
# ==============================================================================
#
# INSTRUCTIONS:
# This file serves as the template for your local environment configuration.
# The startup scripts (start_openfoam.sh / start_openfoam.bat) will automatically
# copy this file to '.env' if '.env' does not exist yet.
#
# You can customize the settings below for your local machine.
# ==============================================================================

# ------------------------------------------------------------------------------
# Host User and Group IDs (Linux & macOS File Permission Safety)
# ------------------------------------------------------------------------------
# In Linux containers, files written by default belong to root (UID 0).
# Setting HOST_UID and HOST_GID tells Docker to run container processes under
# your host user identity so all files created inside /workspace (meshes,
# time-step results, log files) are immediately editable and deletable by you
# on the host system without requiring 'sudo'.
#
# On Linux and macOS, start_openfoam.sh detects your UID/GID automatically.
# On Windows, Docker Desktop automatically handles file permission mapping.
HOST_UID=1000
HOST_GID=1000
