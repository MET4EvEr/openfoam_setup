# ==============================================================================
# OpenFOAM Course Environment Configuration Template
# ==============================================================================
#
# INSTRUCTIONS:
# This file serves as the template for your local environment configuration.
# The startup scripts (start_openfoam.sh / start_openfoam.bat) will automatically
# copy this file to '.env' if '.env' does not exist yet.
#
# You can customize the settings below for your local machine.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host User and Group IDs (Linux & macOS File Permission Safety)
# ------------------------------------------------------------------------------
# In Linux containers, files written by default belong to root (UID 0).
# Setting HOST_UID and HOST_GID tells Docker to run container processes under
# your host user identity so all files created inside /workspace (meshes,
# time-step results, log files) are immediately editable and deletable by you
# on the host system without requiring 'sudo'.
#
# On Linux and macOS, start_openfoam.sh detects your UID/GID automatically.
# On Windows, Docker Desktop automatically handles file permission mapping.
HOST_UID=1000
HOST_GID=1000

# ------------------------------------------------------------------------------
# 2. Local ParaView Executable Path
# ------------------------------------------------------------------------------
# ParaView runs locally on your host OS (Windows or macOS) for full hardware
# GPU acceleration and native desktop responsiveness (avoiding slow X11/VNC).
#
# If left blank, the open_paraview launcher scripts will automatically search
# standard installation paths. If ParaView is installed in a custom location,
# uncomment and set the exact absolute path to your ParaView executable below.
#
# --- WINDOWS EXAMPLES ---
# PARAVIEW_PATH="C:\Program Files\ParaView 5.13.2\bin\paraview.exe"
# PARAVIEW_PATH="C:\Program Files\ParaView 5.12.0\bin\paraview.exe"
#
# --- macOS EXAMPLES ---
# PARAVIEW_PATH="/Applications/ParaView-5.13.2.app/Contents/MacOS/paraview"
# PARAVIEW_PATH="/Applications/ParaView-5.12.0.app/Contents/MacOS/paraview"
#
# --- LINUX EXAMPLES ---
# PARAVIEW_PATH="/usr/bin/paraview"
# PARAVIEW_PATH="/opt/paraview/bin/paraview"
#
PARAVIEW_PATH=
