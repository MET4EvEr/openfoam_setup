FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// WHAT IS THIS FILE?
// Defines the physical transport properties of the working fluid.
// For laminar incompressible flow (e.g., icoFoam), we specify the fluid's
// kinematic viscosity (nu = mu / rho).
//
// DIMENSIONS BREAKDOWN:
//   [Mass, Length, Time, Temperature, Quantity, Current, Luminous Intensity]
// Here: [0 2 -1 0 0 0 0] corresponds to m^2 / s.
//
// REYNOLDS NUMBER (Re) CALCULATION:
//   Re = (U * L) / nu
// Where:
//   U (Lid velocity) = 1.0 m/s
//   L (Cavity width) = 0.1 m
//   nu (Kinematic viscosity) = 0.01 m^2/s
//   Re = (1.0 * 0.1) / 0.01 = 10 (Laminar, highly viscous regime)

transportModel  Newtonian;

nu              [0 2 -1 0 0 0 0] 0.01;

// ************************************************************************* //
