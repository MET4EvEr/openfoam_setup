FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// WHAT IS THIS FILE?
// blockMeshDict is the parametric grid generator configuration for OpenFOAM.
// It defines:
//   1. Spatial coordinates of domain corners (vertices).
//   2. How vertices connect to form hexahedral cell blocks and cell divisions.
//   3. Boundary patches (walls, inlets, symmetry, 2D planes).
//
// CAVITY GEOMETRY:
//   Width (X)  = 0.1 m   (Divided into 20 cells)
//   Height (Y) = 0.1 m   (Divided into 20 cells)
//   Depth (Z)  = 0.01 m  (Divided into 1 cell -> 2D simulation requirement)
//   Total Cells = 20 * 20 * 1 = 400 hexahedral cells.

// Coordinates are specified directly in meters (scale factor = 1.0)
convertToMeters 1;

vertices
(
    (0.00 0.00 0.00) // Vertex 0: Bottom-Left  (Front plane, z=0)
    (0.10 0.00 0.00) // Vertex 1: Bottom-Right (Front plane, z=0)
    (0.10 0.10 0.00) // Vertex 2: Top-Right    (Front plane, z=0)
    (0.00 0.10 0.00) // Vertex 3: Top-Left     (Front plane, z=0)
    (0.00 0.00 0.01) // Vertex 4: Bottom-Left  (Back plane,  z=0.01)
    (0.10 0.00 0.01) // Vertex 5: Bottom-Right (Back plane,  z=0.01)
    (0.10 0.10 0.01) // Vertex 6: Top-Right    (Back plane,  z=0.01)
    (0.00 0.10 0.01) // Vertex 7: Top-Left     (Back plane,  z=0.01)
);

blocks
(
    // Block 0:
    // Defined by 8 corner vertices: (0 1 2 3 4 5 6 7)
    // Mesh resolution: (20 in X, 20 in Y, 1 in Z)
    // simpleGrading (1 1 1): Uniform cell spacing in all directions
    hex (0 1 2 3 4 5 6 7) (20 20 1) simpleGrading (1 1 1)
);

edges
(
    // Straight lines by default; no curved edges needed for square cavity
);

boundary
(
    // -------------------------------------------------------------------------
    // Top boundary: The moving lid (sliding at 1 m/s)
    // -------------------------------------------------------------------------
    movingWall
    {
        type wall;
        faces
        (
            (3 7 6 2)
        );
    }

    // -------------------------------------------------------------------------
    // Left, right, and bottom stationary boundaries
    // -------------------------------------------------------------------------
    fixedWalls
    {
        type wall;
        faces
        (
            (0 4 7 3) // Left wall   (x = 0.0)
            (2 6 5 1) // Right wall  (x = 0.1)
            (1 5 4 0) // Bottom wall (y = 0.0)
        );
    }

    // -------------------------------------------------------------------------
    // 2D Planes: Front (z=0) and Back (z=0.01)
    // 'empty' patch type enforces 2D calculation (no flux across these faces)
    // -------------------------------------------------------------------------
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1) // Front face (z = 0)
            (4 5 6 7) // Back face  (z = 0.01)
        );
    }
);

