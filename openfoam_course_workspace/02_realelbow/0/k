FoamFile {
    version 2.0;
    format ascii;
    class volScalarField;
    object k;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions [0 2 -2 0 0 0 0];

internalField uniform 0.0006;

boundaryField {
    wall {
        type kqRWallFunction;
        value uniform 0.0375;
    }

    symmetry {
        type symmetry;
    }

    velocity-inlet-5 {
        type fixedValue;
        value uniform 0.0006;
    }

    velocity-inlet-6 {
        type fixedValue;
        value uniform 0.00054;
    }

    pressure-outlet-7 {
        type zeroGradient;
    }

}

