FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    wall          
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    symmetry 
    {
        type            symmetry;
    }

    velocity-inlet-5 
    {
        type            fixedValue;
        value           uniform 0;
    }

    velocity-inlet-6 
    {
        type            fixedValue;
        value           uniform 0;
    }

    pressure-outlet-7 
    {
        type            zeroGradient;
    }

}

