FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
        relTol          0;
    }

     pFinal
    {
        $p;
        relTol          0;
    }



    U
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-05;
        relTol          0;
    }

   k
{
    solver          PBiCGStab;
    preconditioner  DILU;
    tolerance       1e-8;
    relTol          0;
}

epsilon
{
     solver          PBiCGStab;
    preconditioner  DILU;
    tolerance       1e-8;
    relTol          0;
}
}

PISO
{
    nCorrectors     2;
    nNonOrthogonalCorrectors 2;
}

relaxationFactors
{
    fields
    {
        p               0.2;
    }

    equations
    {
        U               0.3;
        k               0.3;
        epsilon         0.3;
    }
}
