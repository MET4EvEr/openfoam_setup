FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// WHAT IS THIS FILE?
// This file defines the initial condition and boundary conditions for the
// velocity vector field (U = [Ux, Uy, Uz]).
//
// DIMENSIONS BREAKDOWN:
//   [Mass, Length, Time, Temperature, Quantity, Current, Luminous Intensity]
// Here: [0 1 -1 0 0 0 0] corresponds to velocity in meters per second (m/s).

dimensions      [0 1 -1 0 0 0 0];

// Initial fluid velocity throughout the cavity at time t = 0 (fluid is initially at rest)
internalField   uniform (0 0 0);

boundaryField
{
    // The top lid of the cavity moving horizontally to the right at 1 m/s
    // (Ux = 1.0 m/s, Uy = 0.0 m/s, Uz = 0.0 m/s)
    // This moving boundary drives the primary recirculating vortex inside the cavity.
    movingWall
    {
        type            fixedValue;
        value           uniform (1 0 0);
    }

    // The left, right, and bottom walls are stationary
    // noSlip enforces zero relative velocity at solid walls: U = (0 0 0)
    fixedWalls
    {
        type            noSlip;
    }

    // Front and back boundaries (normal to the z-axis)
    // 'empty' indicates a 2D simulation; forces Uz = 0 and dU/dz = 0.
    frontAndBack
    {
        type            empty;
    }
}

