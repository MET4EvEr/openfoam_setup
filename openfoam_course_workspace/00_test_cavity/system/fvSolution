FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// WHAT IS THIS FILE?
// fvSolution configures the linear equation solvers, preconditioners, tolerances,
// and the pressure-velocity coupling algorithm (PISO).

solvers
{
    // -------------------------------------------------------------------------
    // Pressure Equation Solver (Poisson equation for pressure correction)
    // -------------------------------------------------------------------------
    // PCG = Preconditioned Conjugate Gradient (symmetric positive definite matrix)
    // DIC = Diagonal Incomplete-Cholesky preconditioner
    p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
        relTol          0.05;
    }

    // Final pressure corrector iteration in each time-step
    // relTol 0 forces the solver to converge to the absolute tolerance (1e-06)
    pFinal
    {
        $p;
        relTol          0;
    }

    // -------------------------------------------------------------------------
    // Momentum Equation Solver (Solving for velocity vector components Ux, Uy)
    // -------------------------------------------------------------------------
    // PBiCGStab = Preconditioned Bi-Conjugate Gradient Stabilized (asymmetric matrix)
    // DILU = Diagonal Incomplete-LU preconditioner
    U
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-05;
        relTol          0;
    }
}

// -----------------------------------------------------------------------------
// PISO Algorithm Parameters
// (Pressure-Implicit with Splitting of Operators for transient incompressible flows)
// -----------------------------------------------------------------------------
PISO
{
    // Number of pressure correction loops per time-step
    nCorrectors     2;

    // Additional corrector iterations for non-orthogonal meshes.
    // Set to 0 because our blockMesh cavity is perfectly Cartesian / orthogonal.
    nNonOrthogonalCorrectors 0;

    // PRESSURE DATUM PINNING:
    // Because all boundaries in the enclosed cavity are walls (Dirichlet for velocity),
    // pressure is relative and lacks an absolute boundary reference (like an open outlet).
    // Specifying pRefCell and pRefValue pins the reference pressure datum to 0 at cell 0.
    pRefCell        0;
    pRefValue       0;
}

